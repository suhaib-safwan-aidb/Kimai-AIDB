{% extends 'base.html.twig' %}

{% block page_title %}{{ 'jira_sync.license.title'|trans }}{% endblock %}

{% block main %}
    <div class="row">
        <div class="col-md-6">

            {# Freemium info card (always shown) #}
            {% if license is null or not license.active %}
                <div class="card mb-3 border-info">
                    <div class="card-header bg-info text-white">
                        <h3 class="card-title mb-0">
                            <i class="fas fa-gift me-2"></i>{{ 'jira_sync.freemium.info'|trans }}
                        </h3>
                    </div>
                    <div class="card-body">
                        {% if freeProjectId is not null %}
                            <dl class="row mb-0">
                                <dt class="col-sm-6">{{ 'jira_sync.freemium.free_project_label'|trans }}</dt>
                                <dd class="col-sm-6"><span class="badge bg-success">{{ freeProjectId }}</span></dd>
                            </dl>
                        {% else %}
                            <p class="mb-0 text-muted">{{ 'jira_sync.freemium.no_free_project'|trans }}</p>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {# Current license status card #}
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">{{ 'jira_sync.license.status.title'|trans }}</h3>
                </div>
                <div class="card-body">
                    {% if license is null %}
                        <div class="alert alert-warning mb-0">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            {{ 'jira_sync.license.not_activated'|trans }}
                        </div>
                    {% else %}
                        <dl class="row mb-0">
                            <dt class="col-sm-5">{{ 'jira_sync.license.key'|trans }}</dt>
                            <dd class="col-sm-7"><code>{{ license.licenseKey }}</code></dd>

                            <dt class="col-sm-5">{{ 'jira_sync.license.status.label'|trans }}</dt>
                            <dd class="col-sm-7">
                                {% if license.status == 'active' %}
                                    <span class="badge bg-success">{{ 'jira_sync.license.status.active'|trans }}</span>
                                {% elseif license.status == 'expired' %}
                                    <span class="badge bg-danger">{{ 'jira_sync.license.status.expired'|trans }}</span>
                                {% else %}
                                    <span class="badge bg-secondary">{{ 'jira_sync.license.status.invalid'|trans }}</span>
                                {% endif %}
                            </dd>

                            {% if license.expiresAt is not null %}
                                <dt class="col-sm-5">{{ 'jira_sync.license.expires_at'|trans }}</dt>
                                <dd class="col-sm-7">{{ license.expiresAt|date('Y-m-d') }}</dd>
                            {% endif %}

                            <dt class="col-sm-5">{{ 'jira_sync.license.activated_at'|trans }}</dt>
                            <dd class="col-sm-7">{{ license.activatedAt|date('Y-m-d H:i') }}</dd>

                            {% if license.lastVerifiedAt is not null %}
                                <dt class="col-sm-5">{{ 'jira_sync.license.last_verified_at'|trans }}</dt>
                                <dd class="col-sm-7">{{ license.lastVerifiedAt|date('Y-m-d H:i') }}</dd>
                            {% endif %}
                        </dl>

                        <div class="mt-3">
                            <form method="post" action="{{ path('jira_sync_license_verify') }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('verify-license') }}">
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-sync-alt me-1"></i>{{ 'jira_sync.license.verify_now'|trans }}
                                </button>
                            </form>
                            {% if license.active %}
                            <form method="post" action="{{ path('jira_sync_license_deactivate') }}" class="d-inline ms-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('deactivate-license') }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-times-circle me-1"></i>{{ 'jira_sync.license.deactivate.button'|trans }}
                                </button>
                            </form>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>

        </div>
        <div class="col-md-6">

            {# Activation form card #}
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">{{ 'jira_sync.license.activate.title'|trans }}</h3>
                </div>
                <div class="card-body">
                    {{ form_start(form, {action: path('jira_sync_license_activate')}) }}
                    {{ form_errors(form) }}
                    {{ form_row(form.licenseKey) }}
                    <div class="form-group mt-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-key me-1"></i>{{ 'jira_sync.license.activate.button'|trans }}
                        </button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>

        </div>
    </div>
{% endblock %}
