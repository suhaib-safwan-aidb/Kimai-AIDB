<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">{{ 'jira_sync.credentials.title'|trans }}</h3>
        <div class="card-actions">
            {% if is_project_allowed %}
                <form method="post"
                      action="{{ path('jira_sync_project_sync', {projectId: project.id}) }}"
                      style="display:inline">
                    <input type="hidden" name="_token"
                           value="{{ csrf_token('sync-project-' ~ project.id) }}">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fas fa-sync-alt me-1"></i>{{ 'jira_sync.sync.button'|trans }}
                    </button>
                </form>
                <a href="{{ path('jira_sync_project_credential_new', {projectId: project.id}) }}"
                   class="btn btn-success btn-sm">
                    <i class="fas fa-plus me-1"></i>{{ 'jira_sync.credentials.add'|trans }}
                </a>
            {% else %}
                <span class="badge bg-warning text-dark">
                    <i class="fas fa-lock me-1"></i>{{ 'jira_sync.freemium.license_required'|trans }}
                </span>
            {% endif %}
        </div>
    </div>
    <div class="card-body p-0">
        {% if not is_project_allowed and credentials is empty %}
            <div class="p-3">
                <div class="alert alert-warning mb-0">
                    <i class="fas fa-lock me-2"></i>{{ 'jira_sync.freemium.project_not_allowed'|trans }}
                </div>
            </div>
        {% elseif credentials is empty %}
            <div class="p-3 text-muted">{{ 'jira_sync.credentials.empty'|trans }}</div>
        {% else %}
            <table class="table table-hover dataTable">
                <thead>
                    <tr>
                        {% if is_admin %}
                            <th>{{ 'jira_sync.credentials.user_id'|trans }}</th>
                        {% endif %}
                        <th class="actions"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for credential in credentials %}
                        <tr>
                            {% if is_admin %}
                                <td>{{ usernames[credential.userId] ?? credential.userId }}</td>
                            {% endif %}
                            <td class="actions">
                                <div class="dropdown">
                                    <a href="#" class="link-secondary btn-sm" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="{{ 'jira_sync.action.actions'|trans }}">
                                        <i class="fas fa-ellipsis-h"></i>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <a class="dropdown-item" href="{{ path('jira_sync_project_credential_edit', {projectId: project.id, id: credential.id}) }}">
                                            {{ 'jira_sync.action.edit'|trans }}
                                        </a>
                                        <form method="post" action="{{ path('jira_sync_project_credential_delete', {projectId: project.id, id: credential.id}) }}" onsubmit="return confirm('{{ 'jira_sync.credentials.delete_confirm'|trans }}');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete-project-credential-' ~ credential.id) }}">
                                            <button type="submit" class="dropdown-item text-danger">
                                                {{ 'jira_sync.action.delete'|trans }}
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>
