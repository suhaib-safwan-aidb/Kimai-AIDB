{% extends 'base.html.twig' %}

{% block page_title %}{{ title|trans }}{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ title|trans }}</h3>
        </div>
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="row">
                <div class="col-md-6">
                    {% if form.userId is defined %}
                        {{ form_row(form.userId) }}
                    {% endif %}
                    {{ form_row(form.jiraUsername) }}
                    {{ form_row(form.jiraApiToken) }}
                </div>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> {{ 'action.save'|trans }}
                </button>
                <a href="{{ path('project_details', {id: project.id}) }}" class="btn btn-default">
                    <i class="fas fa-arrow-left"></i> {{ 'action.back'|trans }}
                </a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
