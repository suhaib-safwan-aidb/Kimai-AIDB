{% extends 'base.html.twig' %}

{% block page_title %}{{ 'jira_sync.credentials.title'|trans }}{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ 'jira_sync.credentials.title'|trans }}</h3>
            <div class="card-tools">
                <a href="{{ path('jira_sync_credentials_new') }}" class="btn btn-success btn-sm">
                    <i class="fas fa-plus"></i> {{ 'jira_sync.credentials.add'|trans }}
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            {% if credentials is empty %}
                <div class="p-3">{{ 'jira_sync.credentials.empty'|trans }}</div>
            {% else %}
                <table class="table table-hover dataTable">
                    <thead>
                        <tr>
                            <th>{{ 'jira_sync.credentials.user_id'|trans }}</th>
                            <th>{{ 'jira_sync.credentials.project_id'|trans }}</th>
                            <th>{{ 'jira_sync.credentials.jira_username'|trans }}</th>
                            <th class="actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for credential in credentials %}
                            <tr class="row-clickable" data-href="{{ path('jira_sync_credentials_edit', {id: credential.id}) }}">
                                <td>{{ credential.userId }}</td>
                                <td>{{ credential.projectId }}</td>
                                <td>{{ credential.jiraUsername }}</td>
                                <td class="actions">
                                    <div class="dropdown">
                                        <a href="#" class="link-secondary btn-sm" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="{{ 'jira_sync.action.actions'|trans }}">
                                            <i class="fas fa-ellipsis-h"></i>
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-end">
                                            <a class="dropdown-item" href="{{ path('jira_sync_credentials_edit', {id: credential.id}) }}">
                                                {{ 'jira_sync.action.edit'|trans }}
                                            </a>
                                            <form method="post" action="{{ path('jira_sync_credentials_sync', {id: credential.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('sync-credential-' ~ credential.id) }}">
                                                <button type="submit" class="dropdown-item">
                                                    {{ 'jira_sync.action.sync'|trans }}
                                                </button>
                                            </form>
                                            <form method="post"
                                                  action="{{ path('jira_sync_credentials_delete', {id: credential.id}) }}"
                                                  onsubmit="return confirm('{{ 'jira_sync.credentials.delete_confirm'|trans }}');">
                                                <input type="hidden" name="_token"
                                                       value="{{ csrf_token('delete-credential-' ~ credential.id) }}">
                                                <button type="submit" class="dropdown-item text-danger">
                                                    {{ 'jira_sync.action.delete'|trans }}
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.querySelectorAll('tr.row-clickable').forEach(function (row) {
            row.style.cursor = 'pointer';
            row.addEventListener('click', function (e) {
                if (!e.target.closest('.actions')) {
                    window.location = row.dataset.href;
                }
            });
        });
    </script>
{% endblock %}
